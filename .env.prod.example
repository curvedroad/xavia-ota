HOST=https://updates.example.com
NEXTAUTH_URL=https://updates.example.com

BLOB_STORAGE_TYPE=s3
DB_TYPE=postgres

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_ALLOWED_DOMAIN=example.com
GOOGLE_ALLOWED_EMAILS=admin@example.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

PRIVATE_KEY_BASE_64=your-base64-encoded-private-key

POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=your-database-name
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432

S3_REGION=your-s3-region
S3_ENDPOINT=your-s3-endpoint
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=your-bucket-name
